# Copy to .env in the deployment directory; Docker Compose loads it automatically.
# Never commit real credentials.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
INITIAL_ADMIN_EMAIL=admin@example.com
# At least 16 characters; use a unique random password.
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
# Auth limits are per visitor IP. Disable registration for admin-created accounts only.
PUBLIC_REGISTRATION_ENABLED=true
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
# Private proxy networks. Change matching subnet/address pairs only if they overlap
# existing LAN/VPN/Docker networks. Addresses must be unused members of their subnet.
API_PROXY_SUBNET=172.30.90.0/29
API_PROXY_IP=172.30.90.3
TUNNEL_PROXY_SUBNET=172.30.91.0/29
TUNNEL_WEB_IP=172.30.91.2
TUNNEL_PROXY_IP=172.30.91.3
CLOUDFLARE_TUNNEL_TOKEN=your_token_here
# Mount the backup storage share on the remote server BEFORE starting Compose or updating.
# Directory must already exist. For a local trial, create ./data/backups and use it instead.
# sh deploy/update-server.sh verifies a backup here before installing server updates.
NAS_BACKUP_PATH=/mnt/backup-storage/flocksync_backups
# Public release source for server/addon notices only; updates are deployed manually.
GITHUB_REPOSITORY=GearDuckDev/FlockSync
