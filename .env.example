# Copy to .env in the deployment directory; Docker Compose loads it automatically.
# Never commit real credentials.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
INITIAL_ADMIN_EMAIL=admin@example.com
# At least 16 characters; use a unique random password.
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
CLOUDFLARE_TUNNEL_TOKEN=your_token_here
# Mount the backup storage share on the remote server BEFORE starting Compose or updating.
# Directory must already exist. For a local trial, create ./data/backups and use it instead.
# sh deploy/update-server.sh verifies a backup here before installing server updates.
NAS_BACKUP_PATH=/mnt/backup-storage/flocksync_backups
# Public release source for server/addon notices only; updates are deployed manually.
GITHUB_REPOSITORY=GearDuckDev/FlockSync
