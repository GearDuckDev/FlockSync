{
  "name": "@flocksync/api",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "pnpm --filter @flocksync/shared-types build && tsc",
    "typecheck": "pnpm --filter @flocksync/shared-types build && tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "test:production": "pnpm run build && node --test test/production.test.mjs test/users.test.mjs test/themes.test.mjs",
    "test:updates": "pnpm run build && node --test test/updates.test.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.0",
    "@flocksync/shared-types": "workspace:*",
    "bcryptjs": "^3.0.0",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
