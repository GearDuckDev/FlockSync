{
  "name": "@flocksync/api",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "pnpm --filter @flocksync/shared-types build && tsc",
    "typecheck": "pnpm --filter @flocksync/shared-types build && tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "test:production": "pnpm run build && node --test test/production.test.mjs test/users.test.mjs test/themes.test.mjs test/databaseAdmin.test.mjs test/authControls.test.mjs test/health.test.mjs test/environment.test.mjs test/characterOwnership.test.mjs test/memberSharing.test.mjs test/killPersistence.test.mjs test/groupOwnership.test.mjs test/killObservations.test.mjs",
    "test:updates": "pnpm run build && node --test test/updates.test.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^11.2.2",
    "@flocksync/shared-types": "workspace:*",
    "bcryptjs": "^3.0.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
