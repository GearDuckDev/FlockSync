PORT=3001
HOST=0.0.0.0
DATABASE_URL=./data/flocksync.db
JWT_SECRET=replace-with-secure-secret
# Leave empty for direct/local API access. Compose sets nginx's private IPv4 address.
TRUSTED_PROXY_IP=
PUBLIC_REGISTRATION_ENABLED=true
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Public GitHub repository used for server and addon update notices (owner/repo).
GITHUB_REPOSITORY=GearDuckDev/FlockSync
