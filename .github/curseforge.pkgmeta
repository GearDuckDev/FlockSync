package-as: FlockSync
enable-nolib-creation: no

ignore:
  - .github
  - .vscode
  - .curseforge-release
  - .dockerignore
  - .env
  - .env.production
  - .env.example
  - .gitattributes
  - .gitignore
  - apps/api
  - apps/desktop
  - apps/web
  - apps/addon/FlockSync_AppHelper
  - apps/addon/test
  - deploy
  - packages
  - assets
  - docs
  - scripts
  - node_modules
  - release
  - data
  - DEPLOYMENT.md
  - CURSEFORGE.md
  - README.md
  - RELEASES.md
  - RELEASE-NOTES.md
  - SECURITY-HEALTH-PLAN.md
  - SERVER-OPERATIONS.md
  - UPGRADE-AUDIT-2026-11-04.md
  - UPGRADE-BASELINE.md
  - UPGRADE-INVENTORY-2026-11-04.csv
  - UPGRADE-PLAN.md
  - UPGRADE-TESTS.md
  - UPGRADE-W01.md
  - UPGRADE-W02.md
  - docker-compose.yml
  - Dockerfile.api
  - Dockerfile.web
  - package.json
  - pnpm-lock.yaml
  - pnpm-workspace.yaml
  - tsconfig.base.json

move-folders:
  FlockSync/apps/addon/FlockSync: FlockSync
